# {{ ansible_managed }}
#
# Network configuration for Proxmox VE (PVE) hosts in the homelab.
# This file is managed by Ansible — do not edit manually.
#
# Proxmox uses /etc/network/interfaces (Debian-style networking) to define:
#   - Physical NICs (eth0, nic0, enpXsY, etc.)
#   - Bridges (vmbr0)
#   - VLAN-aware bridges (vmbr0 with vlan-aware yes)
#   - VLAN sub-interfaces (vmbr0.10, vmbr0.20, vmbr0.30)
#
# The homelab design uses VLANs for segmentation (see docs/2_Network_Hosts/TODO.md):
#   - VLAN 10 → Management (router, switch, PVE host management IPs)
#   - VLAN 20 → Services (Kubernetes, VMs, containers)
#   - VLAN 30 → IoT (smart devices, sensors)
#
# See docs/2_Network_Hosts/TODO.md for full details on VLAN layout,
# subnetting, and how Proxmox bridges map to VLAN-tagged traffic.
#
# NOTES:
# - All VMs should attach to vmbr0 and specify a VLAN tag (10, 20, 30).
# - The physical NIC NEVER receives an IP.
# - vmbr0 NEVER receives an IP.
# - Only VLAN sub-interfaces (vmbr0.X) receive IPs.
# - This ensures strict VLAN isolation and matches the homelab network design.

################################################################################
# Loopback interface
################################################################################
auto lo
iface lo inet loopback

################################################################################
# Physical NIC
################################################################################
# The physical NIC is set to "manual" because Proxmox does not assign an IP
# directly to the NIC. Instead, the NIC is attached to vmbr0, and all IP
# configuration happens on the bridge or its VLAN sub-interfaces.
#
# IMPORTANT:
#   - Do NOT assign an IP directly to the physical NIC.
#   - Do NOT use DHCP on the physical NIC.
#   - Do NOT create vmbr0 without vlan-aware=yes — otherwise VLAN-tagged traffic
#     will not be separated correctly.
auto {{ pve_physical_interface }}
iface {{ pve_physical_interface }} inet manual

################################################################################
# Main bridge (vmbr0)
################################################################################
# vmbr0 is the parent bridge for all VLANs. It carries (see docs/2_Network_Hosts/TODO.md):
#   - VLAN 10 (management)
#   - VLAN 20 (services)
#   - VLAN 30 (IoT)
#
# The bridge itself does NOT have an IP address. Instead, each VLAN gets its own
# sub-interface (vmbr0.10, vmbr0.20, vmbr0.30).
#
# vlan-aware=yes is CRITICAL — without it, Proxmox will not tag/untag frames
# correctly, and the router will never see VLAN-tagged traffic.
auto vmbr0
iface vmbr0 inet manual
    bridge-ports {{ pve_physical_interface }}
    bridge-stp off
    bridge-fd 0
    vlan-aware yes

################################################################################
# Management VLAN (vmbr0.10)
################################################################################
# This is the management interface for the Proxmox host.
#
# It receives (see docs/2_Network_Hosts/TODO.md):
#   - A static IP (e.g., 10.42.10.10)
#   - A /24 netmask
#   - The router (10.42.10.1) as the gateway
#
# This interface MUST be VLAN-tagged (vmbr0.10). Assigning the IP directly to
# vmbr0 (untagged) will cause:
#   - The host to land on VLAN 1 (native)
#   - The host to reach the switch (10.42.10.2) but NOT the router (10.42.10.1)
#   - Complete loss of management connectivity
#
# This was the root cause of a previous issue where the Proxmox host could ping
# the switch but not the router — the IP was assigned to vmbr0 instead of vmbr0.10.
auto vmbr0.10
iface vmbr0.10 inet static
    address {{ pve_mgmt_ip }}
    netmask {{ pve_mgmt_netmask }}
    gateway {{ pve_mgmt_gateway }}

################################################################################
# Optional: Additional VLANs (Services, IoT)
################################################################################
# Uncomment and configure these if you want the Proxmox host itself to have IPs
# on VLAN 20 or VLAN 30. Normally, only VMs/containers use these VLANs, not the
# host itself.
# TODO: add this later, for now it is optional but once I am at the step for K8s this is required!
#
# auto vmbr0.20
# iface vmbr0.20 inet static
#     address {{ pve_services_ip }}
#     netmask {{ pve_services_netmask }}
#
# auto vmbr0.30
# iface vmbr0.30 inet static
#     address {{ pve_iot_ip }}
#     netmask {{ pve_iot_netmask }}
