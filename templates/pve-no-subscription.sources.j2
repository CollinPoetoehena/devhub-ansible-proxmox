# {{ ansible_managed }}
#
# Free Proxmox VE repository (no subscription key required), in deb822 format.
#
# deb822 is the modern APT source format used by Debian 13 / Proxmox VE 9. It
# replaces the one-line "deb <uri> <suite> <components>" syntax with explicit
# keys, which makes two things possible that the old format cannot express
# cleanly: an `Enabled:` toggle (so a repository can be disabled without being
# deleted) and a per-source signing key path.
Types: deb
URIs: http://download.proxmox.com/debian/pve
Suites: {{ proxmox_debian_suite }}
Components: pve-no-subscription
Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg
Enabled: true
